# 运行配置模板 —— 复制本文件为 .env 后按需修改
#   cp .env.example .env
# .env 已在 .gitignore 中，不会被提交

# 运行模式：local（SQLite 调试） / cloud（Supabase）
APP_MODE=local

# ============ 以下仅云端模式需要 ============
# Supabase 项目地址（Project Settings → Data API → Project URL）
SUPABASE_URL=
# service_role 密钥（Project Settings → API Keys），只放服务端
SUPABASE_SERVICE_KEY=
# 数据库连接串（Connect → Session pooler），供 psycopg 直连
DATABASE_URL=
# Storage 存储桶名
SUPABASE_BUCKET=class-eval

# ============ 系统参数 ============
# 是否允许老师自助注册账号
ALLOW_TEACHER_SIGNUP=true
# 首次启动自动创建的班主任账号（登录后请立即改密码）
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASSWORD=admin123
# 榜单默认是否显示名次
SHOW_RANK_DEFAULT=true
# 家长登录令牌签名密钥（云端请换成随机长字符串）
APP_SECRET_KEY=please-change-me-to-a-random-secret
# 教室投屏口令
PLAY_CODE=0000
