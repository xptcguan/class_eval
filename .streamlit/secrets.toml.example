# Streamlit Community Cloud 的 Secrets 模板
# ==========================================
# 用法：本地不要用这个文件（本地用 .env）。
# 部署时把下面的内容整段粘贴到
#   share.streamlit.io → Create app → Advanced settings → Secrets
# 或 App 管理后台 → Settings → Secrets，然后 Reboot。
#
# 格式是 TOML：字符串必须用双引号，值里不要有多余空格。

APP_MODE = "cloud"

# ---------- Supabase（必填） ----------
# Project Settings → Data API → Project URL
SUPABASE_URL = "https://xxxxxxxxxxxx.supabase.co"
# Project Settings → API Keys → service_role（服务端密钥，切勿外泄）
SUPABASE_SERVICE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx"
# Connect → Session pooler 的连接串（注意是 pooler，不是 Direct）
DATABASE_URL = "postgresql://postgres.xxxxxxxx:你的密码@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
# Storage 桶名（需与 Supabase 后台创建的桶一致）
SUPABASE_BUCKET = "class-eval"

# ---------- 系统 ----------
# 是否允许老师自助注册；上线后建议改成 "false"
ALLOW_TEACHER_SIGNUP = "true"
# 首次启动创建的班主任账号与密码（请改成强密码）
DEFAULT_ADMIN_USER = "admin"
DEFAULT_ADMIN_PASSWORD = "ChangeMe_2026"
# 榜单默认是否显示名次
SHOW_RANK_DEFAULT = "true"
# 家长登录令牌签名密钥：随机长字符串，一旦更换所有家长需重新登录
APP_SECRET_KEY = "请换成一长串随机字符-abc123xyz-至少32位"
# 教室投屏口令
PLAY_CODE = "8888"
